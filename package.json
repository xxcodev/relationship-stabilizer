{
  "name": "douyin-forwarder",
  "version": "0.8.0",
  "productName": "抖音转发",
  "private": true,
  "type": "commonjs",
  "description": "Scheduled Douyin video forwarding: pick a video from configurable pools, forward it to a friend, all driven by a SQLite-backed scheduler and a local control panel.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/index.js dashboard",
    "init": "node src/index.js init",
    "migrate": "node src/index.js migrate",
    "dashboard": "node src/index.js dashboard",
    "schedule": "node src/index.js schedule",
    "plan": "node src/index.js plan",
    "status": "node src/index.js status",
    "doctor": "node src/index.js doctor",
    "verify": "node src/verify.js",
    "backup": "node src/backup.js",
    "test": "node --test",
    "app:dev": "node scripts/run-electron.js"
  },
  "dependencies": {
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "electron": "^45.4.1"
  },
  "keywords": [
    "douyin",
    "playwright",
    "automation",
    "scheduler",
    "sqlite",
    "dashboard"
  ],
  "author": "wenwu <wenwu@gxshxc.com>",
  "license": "UNLICENSED",
  "main": "app/main.js",
  "bin": {
    "douyin-forwarder": "src/index.js"
  }
}
