{
  "name": "douyin-forwarder",
  "version": "0.8.0",
  "productName": "抖音转发",
  "private": true,
  "type": "commonjs",
  "description": "Scheduled Douyin video forwarding: pick a video from configurable pools, forward it to a friend, all driven by a SQLite-backed scheduler and a local control panel.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/index.js dashboard",
    "init": "node src/index.js init",
    "migrate": "node src/index.js migrate",
    "dashboard": "node src/index.js dashboard",
    "schedule": "node src/index.js schedule",
    "plan": "node src/index.js plan",
    "status": "node src/index.js status",
    "doctor": "node src/index.js doctor",
    "verify": "node src/verify.js",
    "backup": "node src/backup.js",
    "test": "node --test",
    "app:dev": "node scripts/run-electron.js",
    "app:pack": "electron-builder --dir",
    "app:dist:mac": "electron-builder --mac",
    "app:dist:win": "electron-builder --win"
  },
  "dependencies": {
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "keywords": [
    "douyin",
    "playwright",
    "automation",
    "scheduler",
    "sqlite",
    "dashboard"
  ],
  "author": "wenwu <wenwu@gxshxc.com>",
  "license": "GPL-3.0-only",
  "main": "app/main.js",
  "bin": {
    "douyin-forwarder": "src/index.js"
  },
  "build": {
    "appId": "com.dsh.douyin-forwarder",
    "productName": "抖音转发",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "src/**/*",
      "schema/**/*",
      "scripts/**/*",
      "package.json",
      "logo.png"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
