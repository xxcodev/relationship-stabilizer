{
  "name": "douyin-forwarder",
  "version": "0.32.14",
  "productName": "心动投递",
  "private": true,
  "type": "commonjs",
  "description": "Scheduled Douyin video forwarding: pick a video from configurable pools or the recommendation feed, forward it to a friend, driven by a local scheduler (SQLite by default; optional MySQL/PostgreSQL) and a control panel.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/index.js dashboard",
    "init": "node src/index.js init",
    "migrate": "node src/index.js migrate",
    "dashboard": "node src/index.js dashboard",
    "schedule": "node src/index.js schedule",
    "plan": "node src/index.js plan",
    "status": "node src/index.js status",
    "doctor": "node src/index.js doctor",
    "verify": "node src/verify.js",
    "backup": "node src/backup.js",
    "test": "node --test \"test/*.test.js\"",
    "app:dev": "node scripts/run-electron.js",
    "app:pack": "node scripts/build-app.js --variant standard --platform dir",
    "app:dist:mac": "node scripts/build-app.js --variant standard --platform mac",
    "app:dist:win": "node scripts/build-app.js --variant standard --platform win",
    "app:dist:mac:bundled": "node scripts/build-app.js --variant bundled --platform mac",
    "app:dist:win:bundled": "node scripts/build-app.js --variant bundled --platform win",
    "browser:install": "node scripts/install-browser.js",
    "test:mysql": "node scripts/test-mysql.js",
    "test:pg": "node --test test/db-postgres.test.js",
    "test:pg:real": "node scripts/test-pg-real.js"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "mysql-memory-server": "^1.18.0",
    "pg-mem": "^3.0.14",
    "postgres-memory-server": "^0.3.0"
  },
  "keywords": [
    "douyin",
    "playwright",
    "automation",
    "scheduler",
    "sqlite",
    "dashboard",
    "postgresql",
    "mysql",
    "ai"
  ],
  "author": "wenwu <wenwu@gxshxc.com>",
  "license": "GPL-3.0-only",
  "main": "app/main.js",
  "bin": {
    "douyin-forwarder": "src/index.js"
  },
  "build": {
    "appId": "com.dsh.heartbeat-delivery",
    "productName": "心动投递",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "src/**/*",
      "schema/**/*",
      "scripts/**/*",
      "package.json",
      "logo.png"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "heartbeat-delivery-${version}-${arch}.${ext}"
  }
}
