{
  "appId": "com.dsh.heartbeat-delivery",
  "productName": "心动投递",
  "asar": false,
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "app/**/*",
    "src/**/*",
    "schema/**/*",
    "scripts/**/*",
    "package.json",
    "logo.png",
    "!node_modules/playwright-core/.local-browsers/**"
  ],
  "npmRebuild": false,
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.utilities",
    "icon": "build/icon.png",
    "identity": null,
    "hardenedRuntime": false
  },
  "win": {
    "target": [
      "nsis",
      "zip"
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "artifactName": "heartbeat-delivery-bundled-${version}-${arch}.${ext}",
  "extraResources": [
    {
      "from": "node_modules/playwright-core/.local-browsers",
      "to": "playwright-browsers"
    }
  ]
}
