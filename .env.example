# Copy to .env and adjust. Every value has a sensible default.
# The Electron app overrides DATA_DIR / DB_FILE / SHOTS_DIR per data directory.

# Where the SQLite file and browser profiles live (relative to the project root)
DATA_DIR=data
DB_FILE=data/app.db

# Dashboard
DASH_HOST=127.0.0.1
DASH_PORT=9400

# Browser: 'chrome' uses the installed Google Chrome,
# 'chromium' uses the Playwright-bundled build
BROWSER_CHANNEL=chrome
# BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_HEADLESS=false
BROWSER_LOCALE=zh-CN
BROWSER_WIDTH=1280
BROWSER_HEIGHT=900
BROWSER_POS=80,80

# Screenshots: dashboard and browser-server must agree on this value.
SHOTS_DIR=data/shots

# Optional database backend. Default is SQLite. Prefer the panel (data/database.json);
# environment variables override the panel for CI/server use. Password should not be committed.
# DB_DRIVER=postgres
# DB_URL=postgres://user:pass@127.0.0.1:5432/douyin_forwarder
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=douyin_forwarder
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false

# Optional AI (off by default). Prefer the panel (data/ai.json); env vars override.
# AI_ENABLED=true
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_API_KEY=
# AI_TIMEOUT_MS=15000
